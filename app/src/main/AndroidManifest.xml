<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Freeform Unlock"
        android:supportsRtl="true">

        <!-- Metadados que o LSPosed lê para reconhecer o módulo -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Libera janelas flutuantes (freeform) em apps sem suporte no HyperOS/MIUI." />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- Escopo sugerido (marcado automaticamente no LSPosed/Vector) -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
